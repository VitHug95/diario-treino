# Normaliza finais de linha: no repositório tudo é LF; cada checkout usa o
# padrão do SO. Mantém o repo consistente entre Windows (dev) e Linux (CI).
* text=auto eol=lf

# Scripts que precisam de CRLF no Windows.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binários: nunca normalizar.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.otf   binary
*.ttf   binary
